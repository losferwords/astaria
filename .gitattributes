* text=auto eol=lf

*.md text diff=markdown
*.canvas text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.zip binary

# Azgaar separates records with CRLF; the embedded SVG also contains LF.
Assets/Maps/*.map -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
